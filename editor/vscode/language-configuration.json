{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:while\\s*(?:\\(\\s*\\d+\\s*\\))?\\s*:.*|count\\s*(?:\\(\\s*[A-Za-z_][A-Za-z0-9_]*\\s*\\))?\\s*:.*|if\\s*:.*|elif\\s*:.*|else\\s*:\\s*(?:#.*)?|[A-Za-z_][A-Za-z0-9_]*\\(.*\\)\\s*:\\s*(?:#.*)?)$"
  }
}
